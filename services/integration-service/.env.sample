FLASK_APP=app.py
FLASK_ENV=development
# GOOGLE_API_KEY=YOUR_GOOGLE_API_KEY_IF_NEEDED_FOR_PUBLIC_CALENDARS
# No client IDs/secrets here, as this service will consume tokens obtained by auth-service
# or via a direct user consent flow specific to calendar access.

# --- Jira Integration Settings ---
JIRA_SERVER_URL=https://your-domain.atlassian.net
JIRA_USER_EMAIL=your-email@example.com
JIRA_API_TOKEN=your_jira_api_token
# Create API tokens from your Atlassian account settings

# --- Confluence Integration Settings ---
CONFLUENCE_SERVER_URL=https://your-domain.atlassian.net/wiki
CONFLUENCE_USER_EMAIL=your-email@example.com
CONFLUENCE_API_TOKEN=your_confluence_api_token
# Create API tokens from your Atlassian account settings
